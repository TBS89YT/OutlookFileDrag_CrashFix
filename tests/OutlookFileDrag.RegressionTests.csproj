<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <AssemblyName>OutlookFileDrag.RegressionTests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>bin\$(Platform)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\</IntermediateOutputPath>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Optimize>true</Optimize>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="log4net">
      <HintPath>..\packages\log4net.3.5.0\lib\net462\log4net.dll</HintPath>
    </Reference>
    <Compile Include="RegressionTests.cs" />
    <Compile Include="..\OutlookFileDrag\DataObjectHelper.cs"><Link>Production\DataObjectHelper.cs</Link></Compile>
    <Compile Include="..\OutlookFileDrag\OutlookDataObject.cs"><Link>Production\OutlookDataObject.cs</Link></Compile>
    <Compile Include="..\OutlookFileDrag\FileUtility.cs"><Link>Production\FileUtility.cs</Link></Compile>
    <Compile Include="..\OutlookFileDrag\NativeMethods.cs"><Link>Production\NativeMethods.cs</Link></Compile>
    <Compile Include="..\OutlookFileDrag\FormatEtcEnumerator.cs"><Link>Production\FormatEtcEnumerator.cs</Link></Compile>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
